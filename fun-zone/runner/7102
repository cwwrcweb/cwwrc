/* ========== RESET ========== */

*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}



/* ========== BODY ========== */

body{

    min-height:100vh;

    background:

    linear-gradient(
        180deg,
        #050505,
        #151515,
        #000
    );


    color:white;

    font-family:

    Arial,
    Helvetica,
    sans-serif;


    text-align:center;

}




/* ========== HEADER ========== */


.game-header{

    padding:

    35px 20px 20px;

}



.game-header h1{

    font-size:2.4rem;

    color:#ffd700;

    text-shadow:

    0 0 15px #b8860b;

    margin-bottom:12px;

}



.game-header p{

    color:#8fbf5f;

    font-size:1.1rem;

}





/* ========== MAIN CONTAINER ========== */


.game-container{

    width:90%;

    max-width:900px;

    margin:auto;

}





/* ========== INFO BAR ========== */


.game-info{


    display:flex;

    justify-content:space-between;


    background:#1c1c1c;


    border:

    1px solid #b8860b;


    padding:15px 25px;


    border-radius:15px;


    margin-bottom:20px;


    box-shadow:

    0 0 15px rgba(184,134,11,.25);


}




#score,
#high-score{


    color:#ffd700;

    font-weight:bold;


}






/* ========== GAME SCREEN ========== */


.game-screen{


    position:relative;

}





#gameCanvas{


    width:100%;


    max-width:800px;


    height:300px;



    background:

    linear-gradient(

        #202020,

        #050505

    );



    border:

    3px solid #b8860b;



    border-radius:18px;



    box-shadow:


    0 0 30px

    rgba(255,215,0,.25);


}





/* ========== BUTTONS ========== */


.game-controls{


    margin-top:25px;

}



button{


    padding:

    12px 25px;


    margin:8px;



    border:none;


    border-radius:12px;


    cursor:pointer;



    background:#b8860b;


    color:white;


    font-size:1rem;


    transition:.3s;


}



button:hover{


    transform:scale(1.08);


    box-shadow:

    0 0 20px gold;


}





/* ========== FOOTER ========== */


footer{


    margin-top:40px;


    padding:25px;


    border-top:

    1px solid #333;


}



footer a{


    color:#d4a017;


    text-decoration:none;


}







/* ========== MOBILE ========== */


@media(max-width:600px){


.game-header h1{

    font-size:1.8rem;

}



#gameCanvas{

    height:220px;

}



.game-info{

    font-size:.9rem;

}



button{

    width:90%;

}



}