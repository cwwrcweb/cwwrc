/**
 * ============================================================
 * COLLECTOR.JS v2.0 – CWWRC Leaf Collector Game
 * Complete game logic with finger tracking, spawning, collision,
 * score, level, timer, start screen, and play again.
 * ============================================================
 */

(function() {
    "use strict";

    // ============================================================
    // 1. DOM REFERENCES
    // ============================================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const overlay = document.getElementById('overlay');
    const mainBtn = document.getElementById('main-action-btn');
    const scoreSpan = document.getElementById('score-display');
    const levelSpan = document.getElementById('level-display');
    const timerSpan = document.getElementById('timer-display');
    const knob = document.getElementById('knob');

    // ============================================================
    // 2. CANVAS SIZING
    // ============================================================
    function resizeCanvas() {
        // Canvas internal size is fixed at 600x600.
        // We just need to ensure the CSS matches for coordinate mapping.
        // No additional logic required.
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // ============================================================
    // 3. GAME STATE
    // ============================================================
    const STATE = {
        MENU: 0,
        PLAYING: 1,
        GAMEOVER: 2
    };

    let gameState = STATE.MENU;
    let score = 0;
    let level = 1;
    let timeLeft = 30;
    let timerInterval = null;

    // Player position (normalized 0..1)
    let playerX = 0.5;
    let playerY = 0.5;
    let targetX = 0.5;
    let targetY = 0.5;

    // Leaves array
    let leaves = [];
    const MAX_LEAVES = 35;
    let spawnCounter = 0;
    const SPAWN_RATE = 28;

    // Emoji fallback (no external images needed)
    const LEAF_EMOJIS = ['🍂', '🍁', '🌿', '🍀', '🌱'];

    // Animation
    let animationId = null;
    let frameCount = 0;

    // ============================================================
    // 4. HELPER FUNCTIONS
    // ============================================================

    /**
     * Convert client coordinates to normalized canvas coordinates (0..1)
     */
    function getNormalizedCoords(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        const scaleX = 600 / rect.width;
        const scaleY = 600 / rect.height;
        let x = (clientX - rect.left) * scaleX;
        let y = (clientY - rect.top) * scaleY;
        // Clamp to canvas bounds
        x = Math.min(600, Math.max(0, x));
        y = Math.min(600, Math.max(0, y));
        return { x: x / 600, y: y / 600 };
    }

    /**
     * Update knob position with smooth following
     */
    function updateKnobPosition() {
        const SMOOTH = 0.22;
        playerX += (targetX - playerX) * SMOOTH;
        playerY += (targetY - playerY) * SMOOTH;

        const px = playerX * 100;
        const py = playerY * 100;
        knob.style.left = px + '%';
        knob.style.top = py + '%';
    }

    // ============================================================
    // 5. LEAF CLASS
    // ============================================================

    class Leaf {
        constructor(x, y, speed, size, emoji) {
            this.x = x;
            this.y = y;
            this.speed = speed;
            this.size = size;
            this.emoji = emoji || LEAF_EMOJIS[Math.floor(Math.random() * LEAF_EMOJIS.length)];
            this.rotation = Math.random() * 6.28;
            this.rotSpeed = (Math.random() - 0.5) * 0.04;
            this.alive = true;
            this.drift = (Math.random() - 0.5) * 0.003;
        }

        /**
         * Update leaf position each frame
         */
        update() {
            this.y += this.speed;
            this.x += this.drift + Math.sin(this.y * 30) * 0.001;
            // Wrap horizontally
            if (this.x < -0.1) this.x = 1.1;
            if (this.x > 1.1) this.x = -0.1;
            this.rotation += this.rotSpeed;
            if (this.y > 1.2) this.alive = false;
        }

        /**
         * Draw leaf using emoji (fallback-safe)
         */
        draw(ctx) {
            const cx = this.x * 600;
            const cy = this.y * 600;
            const sizePx = this.size * 600;

            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(this.rotation);
            ctx.font = `${sizePx * 1.2}px "Segoe UI Emoji", "Apple Color Emoji", system-ui, sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.shadowColor = 'rgba(0,0,0,0.4)';
            ctx.shadowBlur = 12;
            ctx.fillText(this.emoji, 0, 0);
            ctx.restore();
        }

        /**
         * Check collision with player knob
         */
        collidesWith(px, py, knobRadius) {
            const dx = this.x - px;
            const dy = this.y - py;
            const dist = Math.sqrt(dx * dx + dy * dy);
            return dist < (this.size + knobRadius);
        }
    }

    // ============================================================
    // 6. SPAWNING
    // ============================================================

    function spawnLeaf() {
        const size = 0.045 + Math.random() * 0.055;
        const speed = 0.003 + Math.random() * 0.012 + (level * 0.0012);
        const x = Math.random();
        const y = -0.1 - Math.random() * 0.2;
        const emoji = LEAF_EMOJIS[Math.floor(Math.random() * LEAF_EMOJIS.length)];
        leaves.push(new Leaf(x, y, speed, size, emoji));
    }

    // ============================================================
    // 7. GAME CONTROL FUNCTIONS
    // ============================================================

    /**
     * Reset all game variables to initial state
     */
    function resetGame() {
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
        score = 0;
        level = 1;
        timeLeft = 30;
        leaves = [];
        spawnCounter = 0;
        frameCount = 0;
        playerX = 0.5;
        playerY = 0.5;
        targetX = 0.5;
        targetY = 0.5;
        updateKnobPosition();
        updateHUD();
        overlay.classList.add('hidden');
        mainBtn.textContent = '▶ PLAY';
        gameState = STATE.MENU;
    }

    /**
     * Start the game (called from menu or restart)
     */
    function startGame() {
        resetGame();
        overlay.classList.add('hidden');
        gameState = STATE.PLAYING;
        mainBtn.textContent = '↻ RESTART';

        // Start countdown timer
        timerInterval = setInterval(() => {
            timeLeft -= 1;
            if (timeLeft <= 0) {
                timeLeft = 0;
                updateHUD();
                gameOver();
            } else {
                updateHUD();
                // Level up every 10 seconds
                const newLevel = Math.floor((30 - timeLeft) / 10) + 1;
                if (newLevel !== level) {
                    level = newLevel;
                    updateHUD();
                }
            }
        }, 1000);

        updateHUD();
    }

    /**
     * Game over state
     */
    function gameOver() {
        if (gameState === STATE.GAMEOVER) return;
        gameState = STATE.GAMEOVER;
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }

        // Show overlay with final score
        overlay.classList.remove('hidden');
        overlay.innerHTML = `
            <h1>🍂 Game Over</h1>
            <h2>Score: <span id="final-score">${score}</span></h2>
            <p>level ${level} · collected ${score} leaves</p>
            <button class="btn" id="main-action-btn">🔄 PLAY AGAIN</button>
            <div style="margin-top:0.6rem; font-size:0.8rem; opacity:0.6;">tap to retry</div>
        `;

        // Re-bind button
        document.getElementById('main-action-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            resetGame();
            startGame();
        });

        // Tap overlay to restart
        overlay.addEventListener('click', function handler(e) {
            if (e.target === overlay || e.target.tagName === 'DIV' || e.target.tagName === 'P') {
                resetGame();
                startGame();
            }
            overlay.removeEventListener('click', handler);
        });

        updateHUD();
    }

    /**
     * Update HUD display
     */
    function updateHUD() {
        scoreSpan.textContent = score;
        levelSpan.textContent = `🌿 Lv.${level}`;
        timerSpan.textContent = `⏳ ${timeLeft}s`;
    }

    // ============================================================
    // 8. COLLISION DETECTION
    // ============================================================

    function processCollisions() {
        const knobRadius = 0.065;
        for (let i = leaves.length - 1; i >= 0; i--) {
            const leaf = leaves[i];
            if (!leaf.alive) continue;
            if (leaf.collidesWith(playerX, playerY, knobRadius)) {
                leaf.alive = false;
                score++;
                updateHUD();
                // Level up every 8 leaves
                const newLevel = Math.floor(score / 8) + 1;
                if (newLevel > level) {
                    level = newLevel;
                    updateHUD();
                }
                leaves.splice(i, 1);
            }
        }
    }

    // ============================================================
    // 9. DRAWING
    // ============================================================

    function drawScene() {
        ctx.clearRect(0, 0, 600, 600);

        // Draw all leaves
        for (const leaf of leaves) {
            leaf.draw(ctx);
        }

        // Draw player glow effect
        const px = playerX * 600;
        const py = playerY * 600;
        ctx.beginPath();
        ctx.arc(px, py, 28, 0, 2 * Math.PI);
        ctx.fillStyle = 'rgba(255, 215, 100, 0.15)';
        ctx.shadowColor = 'rgba(255, 200, 50, 0.3)';
        ctx.shadowBlur = 30;
        ctx.fill();
        ctx.shadowBlur = 0;

        // Draw ring
        ctx.beginPath();
        ctx.arc(px, py, 18, 0, 2 * Math.PI);
        ctx.strokeStyle = 'rgba(255, 235, 140, 0.3)';
        ctx.lineWidth = 3;
        ctx.stroke();
    }

    // ============================================================
    // 10. GAME LOOP
    // ============================================================

    function gameLoop() {
        if (gameState === STATE.PLAYING) {
            frameCount++;

            // Spawn leaves
            spawnCounter++;
            if (spawnCounter >= SPAWN_RATE) {
                spawnCounter = 0;
                if (leaves.length < MAX_LEAVES) {
                    spawnLeaf();
                    if (Math.random() < 0.25 && leaves.length < MAX_LEAVES - 2) {
                        spawnLeaf();
                    }
                }
            }

            // Update leaves
            for (let i = leaves.length - 1; i >= 0; i--) {
                leaves[i].update();
                if (!leaves[i].alive) {
                    leaves.splice(i, 1);
                }
            }

            // Process collisions
            processCollisions();

            // Smooth knob follow
            updateKnobPosition();

            // Draw
            drawScene();

            // Continue loop
            animationId = requestAnimationFrame(gameLoop);
        } else if (gameState === STATE.MENU) {
            drawScene();
            animationId = requestAnimationFrame(gameLoop);
        } else if (gameState === STATE.GAMEOVER) {
            drawScene();
            animationId = requestAnimationFrame(gameLoop);
        } else {
            animationId = requestAnimationFrame(gameLoop);
        }
    }

    // ============================================================
    // 11. EVENT LISTENERS (Finger/Mouse Tracking)
    // ============================================================

    /**
     * Handle pointer move (finger or mouse drag)
     */
    function handlePointerMove(e) {
        if (gameState !== STATE.PLAYING) return;
        e.preventDefault();

        let clientX, clientY;
        if (e.touches) {
            clientX = e.touches[0].clientX;
            clientY = e.touches[0].clientY;
        } else {
            clientX = e.clientX;
            clientY = e.clientY;
        }

        const norm = getNormalizedCoords(clientX, clientY);
        targetX = norm.x;
        targetY = norm.y;
    }

    /**
     * Handle pointer start (tap on canvas)
     */
    function handlePointerStart(e) {
        if (gameState !== STATE.PLAYING) return;
        e.preventDefault();
        handlePointerMove(e);
    }

    // Touch events
    canvas.addEventListener('touchstart', handlePointerStart, { passive: false });
    canvas.addEventListener('touchmove', handlePointerMove, { passive: false });
    canvas.addEventListener('touchend', (e) => { e.preventDefault(); }, { passive: false });

    // Mouse events
    canvas.addEventListener('mousedown', handlePointerStart);
    canvas.addEventListener('mousemove', (e) => {
        if (e.buttons === 1) {
            handlePointerMove(e);
        }
    });

    // Prevent context menu
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());

    // ============================================================
    // 12. MENU / RESTART BUTTON
    // ============================================================

    mainBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (gameState === STATE.MENU || gameState === STATE.GAMEOVER) {
            resetGame();
            startGame();
        } else {
            resetGame();
            startGame();
        }
    });

    // ============================================================
    // 13. INITIALIZATION
    // ============================================================

    resetGame();
    gameLoop();
    updateKnobPosition();

    console.log('🍂 CWWRC Leaf Collector v2.0 loaded – mobile-first, full finger tracking.');
    console.log('📦 All features: start screen, play again, timer, score, level, spawning, collision, emoji fallback.');

})();