/* ===================================
   CWWRC TEAM PAGE CSS
   PREMIUM GOLD & RED VERSION
=================================== */


*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}



body{

    font-family:
    "Segoe UI",
    Arial,
    sans-serif;


    background:
    linear-gradient(
        135deg,
        #8b0000,
        #b8860b,
        #5a0000
    );


    color:#222;

}



/* ================= HEADER ================= */


.team-header{


    min-height:300px;


    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;


    text-align:center;


    padding:40px 20px;



    background:

    linear-gradient(
        rgba(0,0,0,0.75),
        rgba(0,0,0,0.75)
    ),

    url("assets/images/teambg.png");



    background-size:cover;


    background-position:center;



    color:white;


}




.team-header h1{


    font-size:52px;


    margin-bottom:15px;


    letter-spacing:2px;


}




.team-header p{


    font-size:20px;


    color:#ddd;


}







/* ================= CONTAINER ================= */


.container{


    width:90%;


    max-width:1250px;


    margin:auto;


}








/* ================= SECTION ================= */


.team-section{


    padding:80px 0;


    background:
    rgba(255,255,255,0.10);


}






.team-section h2{


    text-align:center;


    font-size:36px;


    color:#ffd700;


    margin-bottom:50px;


    text-shadow:

    0 2px 5px rgba(0,0,0,0.5);


}





.team-section h2::after{


    content:"";


    display:block;


    width:90px;


    height:4px;


    background:#ffd700;


    margin:15px auto;


}








/* ================= GRID ================= */


.team-grid{


    display:grid;


    grid-template-columns:

    repeat(auto-fit,minmax(260px,1fr));


    gap:40px;


}








/* ================= CARD ================= */


.team-card{


    background:

    rgba(255,255,255,0.95);



    border-radius:25px;


    padding:35px 25px;



    text-align:center;



    box-shadow:

    0 15px 35px
    rgba(0,0,0,0.25);



    transition:0.4s;



    border-top:

    6px solid #ffd700;


}







.team-card:hover{


    transform:

    translateY(-15px);



    box-shadow:

    0 25px 50px
    rgba(0,0,0,0.35);


}








/* ================= PHOTO ================= */


.team-card img{


    width:180px;


    height:180px;


    object-fit:cover;



    border-radius:50%;



    border:

    8px solid white;



    outline:

    4px solid #b8860b;



    margin-bottom:25px;



    transition:0.4s;


}





.team-card:hover img{


    transform:

    scale(1.05);


}








/* ================= NAME ================= */


.team-card h3{


    font-size:28px;



    color:#800000;



    margin-bottom:12px;



}







/* ================= POSITION ================= */


.team-card p{


    display:inline-block;



    padding:8px 18px;



    border-radius:20px;



    background:#111;



    color:white;



    font-size:14px;



}








/* ================= FOOTER ================= */


footer{


    background:#111;


    color:white;



    text-align:center;



    padding:30px;



}








/* ================= MOBILE ================= */


@media(max-width:600px){



.team-header h1{


    font-size:36px;


}




.team-header p{


    font-size:16px;


}




.team-card img{


    width:140px;


    height:140px;


}




.team-section h2{


    font-size:28px;


}




}